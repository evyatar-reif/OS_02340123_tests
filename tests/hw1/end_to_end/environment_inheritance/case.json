{
  "mode": "interactive",
  "timeout": 25,
  "description": "Compare environment inheritance across redirected built-ins, pipeline children, and a wildcard command",
  "setup": [
    {
      "type": "file",
      "path": "work/source/a.txt",
      "text": "first\n"
    },
    {
      "type": "file",
      "path": "work/source/b.txt",
      "text": "second\n"
    }
  ],
  "files": [
    "work/env.txt",
    "work/unset.txt"
  ],
  "env": {
    "SMASH_FLOW": "old",
    "SMASH_KEEP": "kept",
    "SMASH_CHILD": "parent"
  },
  "identity": true,
  "values": [
    {
      "name": "SOURCE_KB",
      "kind": "du",
      "path": "work/source",
      "pattern": "Total disk usage: (?P<value>[0-9]+) KB"
    }
  ],
  "pid_patterns": [
    "sleep 91 \\& (?P<pid>[0-9]+)"
  ],
  "steps": [
    {"expect": "smash> "},
    {"send": "cd work"},
    {"expect": "(?<=smash> )smash> "},
    {"send": "chprompt environment"},
    {"expect": "(?<=smash> )environment> "},
    {"send": "alias hold='sleep'"},
    {"expect": "(?<=environment> )environment> "},
    {"send": "hold 90 &"},
    {"wait_child": "first", "command": "sleep", "timeout": 5},
    {"expect": "environment> "},
    {"send": "sleep 91 &"},
    {"wait_child": "second", "command": "sleep", "timeout": 5},
    {"expect": "environment> "},
    {"send": "jobs"},
    {"expect": "(?<=environment> )\\[1\\] hold 90 \\&\\n\\[2\\] sleep 91 \\&\\nenvironment> "},
    {"send": "printenv SMASH_FLOW > env.txt"},
    {"expect": "(?<=environment> )environment> "},
    {"send": "unsetenv SMASH_FLOW > unset.txt"},
    {"expect": "(?<=environment> )environment> "},
    {"send": "unsetenv SMASH_CHILD | cat"},
    {"expect": "(?<=environment> )environment> "},
    {"send": "printenv SMASH_FLOW SMASH_KEEP >> env.txt"},
    {"expect": "(?<=environment> )environment> "},
    {"send": "cat env.txt | grep -n kept"},
    {"expect": "(?<=environment> )2:kept\\nenvironment> "},
    {"send": "cat env.txt"},
    {"expect": "(?<=environment> )old\\nkept\\nenvironment> "},
    {"send": "printenv SMASH_FLOW SMASH_CHILD"},
    {"expect": "(?<=environment> )parent\\nenvironment> "},
    {"send": "cat source/*.txt"},
    {"expect": "(?<=environment> )first\\nsecond\\nenvironment> "},
    {"send": "cat absent.txt |& wc -l"},
    {"expect": "(?<=environment> )1\\nenvironment> "},
    {"send": "getfiletype unset.txt"},
    {"expect": "(?<=environment> )unset\\.txt's type is \"regular file\" and takes up 0 bytes\\nenvironment> "},
    {"send": "du source"},
    {"expect": "(?<=environment> )Total disk usage: [0-9]+ KB\\nenvironment> "},
    {"send": "whoami | cat"},
    {"expect": "(?<=environment> )[^\\n]+\\n[0-9]+\\n[0-9]+\\n/[^\\n]*\\nenvironment> "},
    {"send": "showpid"},
    {"expect": "(?<=environment> )smash pid is {{SHELL_PID}}\\nenvironment> "},
    {"send": "pwd"},
    {"expect": "(?<=environment> ){{WORKDIR}}/work\\nenvironment> "},
    {"send": "fg"},
    {"expect": "sleep 91 \\& {{second}}\\n"},
    {"wait_child": "second", "command": "sleep", "foreground": true, "timeout": 5},
    {"ctrl_c": true},
    {"expect": "smash: got ctrl-C\\nsmash: process {{second}} was killed\\nenvironment> "},
    {"wait_exit": "second", "timeout": 5},
    {"send": "kill -15 1"},
    {"expect": "(?<=environment> )signal number 15 was sent to pid {{first}}\\nenvironment> "},
    {"wait_exit": "first", "timeout": 5},
    {"send": "jobs"},
    {"expect": "(?<=environment> )environment> "},
    {"send": "unalias hold"},
    {"expect": "(?<=environment> )environment> "},
    {"send": "chprompt"},
    {"expect": "(?<=environment> )smash> "},
    {"send": "quit kill"},
    {"expect": "smash: sending SIGKILL signal to 0 jobs:\\n"}
  ]
}
