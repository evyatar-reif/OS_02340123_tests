{
  "mode": "interactive",
  "timeout": 10,
  "description": "Reap finished jobs and reuse maximal ID plus one",
  "steps": [
    {
      "expect": "smash> "
    },
    {
      "send": "sleep 30 &"
    },
    {
      "wait_child": "first",
      "command": "sleep"
    },
    {
      "expect": "smash> "
    },
    {
      "send": "jobs"
    },
    {
      "expect": "\\[1\\] sleep 30 &"
    },
    {
      "expect": "smash> "
    },
    {
      "send": "kill -9 1"
    },
    {
      "expect": "signal number 9 was sent to pid {{first}}"
    },
    {
      "expect": "smash> "
    },
    {
      "wait_exit": "first"
    },
    {
      "send": "sleep 30 &"
    },
    {
      "wait_child": "second",
      "command": "sleep"
    },
    {
      "expect": "smash> "
    },
    {
      "send": "jobs"
    },
    {
      "expect": "\\[1\\] sleep 30 &"
    },
    {
      "expect": "smash> "
    },
    {
      "send": "quit kill"
    }
  ]
}
