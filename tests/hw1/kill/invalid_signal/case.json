{
  "mode": "interactive",
  "timeout": 8,
  "description": "Out-of-range signal reaches kill and is reported with perror",
  "steps": [
    {
      "expect": "smash> "
    },
    {
      "send": "sleep 30 &"
    },
    {
      "wait_child": "job",
      "command": "sleep"
    },
    {
      "expect": "smash> "
    },
    {
      "send": "kill -999 1"
    },
    {
      "expect": "smash error: kill failed: Invalid argument"
    },
    {
      "expect": "smash> "
    },
    {
      "send": "kill -9 1"
    },
    {
      "expect": "signal number 9 was sent to pid {{job}}"
    },
    {
      "expect": "smash> "
    },
    {
      "wait_exit": "job"
    },
    {
      "send": "quit kill"
    }
  ]
}
